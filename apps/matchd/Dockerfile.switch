# switch-clang target. Clang emits little-endian AArch64 ELF.
# The Nintendo SDK Clang is a different compiler. This image also keeps host gcc.
FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    gcc g++ binutils ca-certificates bubblewrap \
    clang llvm \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json ./
RUN npm install

COPY tsconfig.json ./
COPY src ./src
COPY drivers/switch-clang /usr/local/bin/switch-clang
RUN sed -i 's/\r$//' /usr/local/bin/switch-clang && chmod +x /usr/local/bin/switch-clang

ENV MATCHD_PORT=3001
ENV MATCHD_GCC=gcc
ENV MATCHD_GXX=g++
ENV MATCHD_LD=ld
ENV MATCHD_NM=nm
ENV MATCHD_OBJDUMP=objdump
ENV MATCHD_CLANG=switch-clang
ENV MATCHD_CLANG_BIN=/usr/bin/clang
ENV MATCHD_LLVM_NM=llvm-nm
ENV MATCHD_LLVM_OBJDUMP=llvm-objdump
ENV MATCHD_TIMEOUT_MS=30000
ENV MATCHD_SANDBOX=bwrap

EXPOSE 3001
CMD ["npx", "tsx", "src/main.ts"]
