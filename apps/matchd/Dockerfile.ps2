# ps2-gcc target. Debian mips64el GCC targets the R5900 with single-float.
# Sony ee-gcc is a different compiler. This image also keeps host gcc.
FROM node:22-bookworm-slim@sha256:5ec23b7c622b00547753bc6ffd78085dd868a68aeb41c8e0a1418f033e13d96d

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    gcc g++ binutils ca-certificates bubblewrap \
    gcc-mips64el-linux-gnuabi64 g++-mips64el-linux-gnuabi64 \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json ./
RUN npm install --omit=dev

COPY tsconfig.json ./
COPY src ./src
COPY drivers/ps2-gcc /usr/local/bin/ps2-gcc
COPY drivers/ps2-g++ /usr/local/bin/ps2-g++
RUN sed -i 's/\r$//' /usr/local/bin/ps2-gcc /usr/local/bin/ps2-g++ \
  && chmod +x /usr/local/bin/ps2-gcc /usr/local/bin/ps2-g++

ENV MATCHD_PORT=3001
ENV MATCHD_GCC=gcc
ENV MATCHD_GXX=g++
ENV MATCHD_LD=ld
ENV MATCHD_NM=nm
ENV MATCHD_OBJDUMP=objdump
ENV MATCHD_PS2_GCC=ps2-gcc
ENV MATCHD_PS2_GXX=ps2-g++
ENV MATCHD_PS2_NM=mips64el-linux-gnuabi64-nm
ENV MATCHD_PS2_OBJDUMP=mips64el-linux-gnuabi64-objdump
ENV MATCHD_TIMEOUT_MS=30000
ENV MATCHD_SANDBOX=bwrap

EXPOSE 3001
CMD ["node", "--import", "tsx", "src/main.ts"]
