# genesis-gcc target. Debian m68k-linux-gnu GCC targets the 68000 with -m68000.
# The SN Systems compiler and Sierra C are different binaries. This image also keeps host gcc.
FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    gcc g++ binutils ca-certificates bubblewrap \
    gcc-m68k-linux-gnu g++-m68k-linux-gnu \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json ./
RUN npm install

COPY tsconfig.json ./
COPY src ./src
COPY drivers/genesis-gcc /usr/local/bin/genesis-gcc
COPY drivers/genesis-g++ /usr/local/bin/genesis-g++
RUN sed -i 's/\r$//' /usr/local/bin/genesis-gcc /usr/local/bin/genesis-g++ \
  && chmod +x /usr/local/bin/genesis-gcc /usr/local/bin/genesis-g++

ENV MATCHD_PORT=3001
ENV MATCHD_GCC=gcc
ENV MATCHD_GXX=g++
ENV MATCHD_LD=ld
ENV MATCHD_NM=nm
ENV MATCHD_OBJDUMP=objdump
ENV MATCHD_GENESIS_GCC=genesis-gcc
ENV MATCHD_GENESIS_GXX=genesis-g++
ENV MATCHD_GENESIS_NM=m68k-linux-gnu-nm
ENV MATCHD_GENESIS_OBJDUMP=m68k-linux-gnu-objdump
ENV MATCHD_TIMEOUT_MS=30000
ENV MATCHD_SANDBOX=bwrap

EXPOSE 3001
CMD ["npx", "tsx", "src/main.ts"]
