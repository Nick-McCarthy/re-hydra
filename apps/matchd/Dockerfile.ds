# ds-gcc target. Debian arm-none-eabi GCC emits little-endian ARM ELF.
# mwccarm and armcc are different compilers. This image also keeps host gcc.
FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    gcc g++ binutils ca-certificates bubblewrap \
    gcc-arm-none-eabi \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json ./
RUN npm install

COPY tsconfig.json ./
COPY src ./src

ENV MATCHD_PORT=3001
ENV MATCHD_GCC=gcc
ENV MATCHD_GXX=g++
ENV MATCHD_LD=ld
ENV MATCHD_NM=nm
ENV MATCHD_OBJDUMP=objdump
ENV MATCHD_DS_GCC=arm-none-eabi-gcc
ENV MATCHD_DS_GXX=arm-none-eabi-g++
ENV MATCHD_DS_NM=arm-none-eabi-nm
ENV MATCHD_DS_OBJDUMP=arm-none-eabi-objdump
ENV MATCHD_TIMEOUT_MS=30000
ENV MATCHD_SANDBOX=bwrap

EXPOSE 3001
CMD ["npx", "tsx", "src/main.ts"]
