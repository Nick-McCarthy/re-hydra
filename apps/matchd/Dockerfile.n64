# n64-gcc target: GNU GCC 2.8.1 for big-endian MIPS, plus host gcc.
# This is the public GNU release, not the Nintendo SDK compiler and not IDO.
FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    gcc g++ binutils ca-certificates bubblewrap \
    gcc-multilib libc6-dev-i386 \
    binutils-mips-linux-gnu \
    make wget \
  && rm -rf /var/lib/apt/lists/*

# Stock 2.8.1 defaults to big-endian MIPS, which is what N64 uses.
# The obstack change is the one needed to compile this release with a modern gcc.
RUN wget -O /tmp/gcc-2.8.1.tar.gz https://ftp.gnu.org/gnu/gcc/gcc-2.8.1.tar.gz \
  && tar -xzf /tmp/gcc-2.8.1.tar.gz -C /tmp \
  && cd /tmp/gcc-2.8.1 \
  && sed -i 's/include <varargs.h>/include <stdarg.h>/g' *.c \
  && sed -i \
    -e 's/\*((void \*\*)__o->next_free)++ = ((void \*)datum);/*((void **)__o->next_free) = ((void *)datum); __o->next_free += sizeof (void *);/' \
    -e 's/\*((int \*)__o->next_free)++ = ((int)datum);/*((int *)__o->next_free) = ((int)datum); __o->next_free += sizeof (int);/' \
    obstack.h \
  && ./configure \
    --target=mips-linux-gnu \
    --prefix=/opt/n64 \
    --with-gnu-as \
    --disable-gprof \
    --disable-gdb \
    --disable-werror \
    --host=i386-pc-linux-gnu \
    --build=i386-pc-linux-gnu \
  && touch insn-config.h \
  && make --jobs "$(nproc)" cpp cc1 xgcc CFLAGS="-std=gnu89 -m32 -static -fcommon" \
  && mkdir -p /opt/n64/bin /opt/n64/lib/gcc-lib/mips-linux-gnu/2.8.1 \
  && cp cc1 cpp /opt/n64/lib/gcc-lib/mips-linux-gnu/2.8.1/ \
  && cp xgcc /opt/n64/bin/mips-linux-gnu-gcc \
  && ln -s /usr/bin/mips-linux-gnu-as /opt/n64/bin/as \
  && rm -rf /tmp/gcc-2.8.1 /tmp/gcc-2.8.1.tar.gz

ENV PATH="/opt/n64/bin:${PATH}"

WORKDIR /app

COPY package.json ./
RUN npm install

COPY tsconfig.json ./
COPY src ./src

ENV MATCHD_PORT=3001
ENV MATCHD_GCC=gcc
ENV MATCHD_GXX=g++
ENV MATCHD_LD=ld
ENV MATCHD_NM=nm
ENV MATCHD_OBJDUMP=objdump
ENV MATCHD_N64_GCC=/opt/n64/bin/mips-linux-gnu-gcc
ENV MATCHD_MIPS_NM=mips-linux-gnu-nm
ENV MATCHD_MIPS_OBJDUMP=mips-linux-gnu-objdump
ENV MATCHD_TIMEOUT_MS=30000
ENV MATCHD_SANDBOX=bwrap
ENV MATCHD_TOKEN=dev-matchd-token

EXPOSE 3001
CMD ["npx", "tsx", "src/main.ts"]
