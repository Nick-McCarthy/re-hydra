# wiiu-gcc target. Debian powerpc GCC emits big-endian PowerPC ELF.
# The Cafe SDK compiler is a different compiler. This image also keeps host gcc.
FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    gcc g++ binutils ca-certificates bubblewrap \
    gcc-powerpc-linux-gnu g++-powerpc-linux-gnu \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json ./
RUN npm install

COPY tsconfig.json ./
COPY src ./src

ENV MATCHD_PORT=3001
ENV MATCHD_GCC=gcc
ENV MATCHD_GXX=g++
ENV MATCHD_LD=ld
ENV MATCHD_NM=nm
ENV MATCHD_OBJDUMP=objdump
ENV MATCHD_WIIU_GCC=powerpc-linux-gnu-gcc
ENV MATCHD_WIIU_GXX=powerpc-linux-gnu-g++
ENV MATCHD_WIIU_NM=powerpc-linux-gnu-nm
ENV MATCHD_WIIU_OBJDUMP=powerpc-linux-gnu-objdump
ENV MATCHD_TIMEOUT_MS=30000
ENV MATCHD_SANDBOX=bwrap
ENV MATCHD_TOKEN=dev-matchd-token

EXPOSE 3001
CMD ["npx", "tsx", "src/main.ts"]
