MATCHD_PORT=3001
# Required, no default. Must equal the API's MATCHD_TOKEN. Use a real secret outside local dev.
MATCHD_TOKEN=dev-matchd-token
# Host tools (Linux/macOS or WSL). Docker image installs these automatically.
MATCHD_GCC=gcc
MATCHD_OBJDUMP=objdump
MATCHD_TIMEOUT_MS=30000
# off uses the host compiler directly. The Docker image sets bwrap.
MATCHD_SANDBOX=off
