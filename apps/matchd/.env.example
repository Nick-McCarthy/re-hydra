MATCHD_PORT=3001
# Required, no default. Must equal the API's MATCHD_TOKEN. Use a real secret outside local dev.
MATCHD_TOKEN=dev-matchd-token
# Host tools (Linux/macOS or WSL). Docker image installs these automatically.
MATCHD_GCC=gcc
MATCHD_OBJDUMP=objdump
MATCHD_TIMEOUT_MS=30000
# off uses the host compiler directly. The Docker image sets bwrap.
MATCHD_SANDBOX=off
# Request body cap in MB (audit A-034). A link job carries every unit's source.
MATCHD_MAX_BODY_MB=64
# Data-segment cap per compile process in MB (audit A-013). prlimit --data inside the sandbox.
MATCHD_MEMORY_MB=1024
# Integration builds: units compiled at once (default: CPU count, at most 8),
# and the on-disk cache of compiled units, which makes a rebuild after a few
# new matches take seconds. 0 MB turns the cache off. Mount the directory as a
# volume to keep it across container restarts; entries from other matchd code
# are never reused, because the key includes a hash of matchd's src/
# (override with MATCHD_BUILD_ID).
MATCHD_LINK_CONCURRENCY=8
MATCHD_LINK_CACHE_DIR=/tmp/rehydra-link-cache
MATCHD_LINK_CACHE_MB=1024
