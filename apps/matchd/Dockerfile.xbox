# xbox-i386 target. Clang emits i386 COFF for the Microsoft ABI.
# Visual C++ 6 and 7 are different compilers. This image also keeps host gcc.
FROM node:22-bookworm-slim@sha256:5ec23b7c622b00547753bc6ffd78085dd868a68aeb41c8e0a1418f033e13d96d

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    gcc g++ binutils ca-certificates bubblewrap \
    clang llvm \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json ./
RUN npm install --omit=dev

COPY tsconfig.json ./
COPY src ./src
COPY drivers/xbox-clang /usr/local/bin/xbox-clang
RUN sed -i 's/\r$//' /usr/local/bin/xbox-clang && chmod +x /usr/local/bin/xbox-clang

ENV MATCHD_PORT=3001
ENV MATCHD_GCC=gcc
ENV MATCHD_GXX=g++
ENV MATCHD_LD=ld
ENV MATCHD_NM=nm
ENV MATCHD_OBJDUMP=objdump
ENV MATCHD_CLANG=xbox-clang
ENV MATCHD_CLANG_BIN=/usr/bin/clang
ENV MATCHD_LLVM_NM=llvm-nm
ENV MATCHD_LLVM_OBJDUMP=llvm-objdump
ENV MATCHD_TIMEOUT_MS=30000
ENV MATCHD_SANDBOX=bwrap

EXPOSE 3001
CMD ["node", "--import", "tsx", "src/main.ts"]
