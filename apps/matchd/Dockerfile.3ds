# 3ds-gcc target. Debian arm-none-eabi GCC targets the ARM11 with armv6k.
# ARM Compiler 5 is a different compiler. This image also keeps host gcc.
FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    gcc g++ binutils ca-certificates bubblewrap \
    gcc-arm-none-eabi \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json ./
RUN npm install

COPY tsconfig.json ./
COPY src ./src
COPY drivers/3ds-gcc /usr/local/bin/3ds-gcc
COPY drivers/3ds-g++ /usr/local/bin/3ds-g++
RUN sed -i 's/\r$//' /usr/local/bin/3ds-gcc /usr/local/bin/3ds-g++ \
  && chmod +x /usr/local/bin/3ds-gcc /usr/local/bin/3ds-g++

ENV MATCHD_PORT=3001
ENV MATCHD_GCC=gcc
ENV MATCHD_GXX=g++
ENV MATCHD_LD=ld
ENV MATCHD_NM=nm
ENV MATCHD_OBJDUMP=objdump
ENV MATCHD_3DS_GCC=3ds-gcc
ENV MATCHD_3DS_GXX=3ds-g++
ENV MATCHD_3DS_NM=arm-none-eabi-nm
ENV MATCHD_3DS_OBJDUMP=arm-none-eabi-objdump
ENV MATCHD_TIMEOUT_MS=30000
ENV MATCHD_SANDBOX=bwrap
ENV MATCHD_TOKEN=dev-matchd-token

EXPOSE 3001
CMD ["npx", "tsx", "src/main.ts"]
