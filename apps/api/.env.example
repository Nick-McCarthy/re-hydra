DATABASE_URL=postgres://rehydra:rehydra@127.0.0.1:5432/rehydra
API_PORT=3000
PUBLIC_API_URL=http://localhost:3000
# postgres keeps bytes in blob_objects. s3 uses the local bucket (us-east-1 signing region).
BLOB_STORE=s3
BLOB_S3_ENDPOINT=http://127.0.0.1:9000
BLOB_S3_BUCKET=rehydra
BLOB_S3_ACCESS_KEY=rehydra
BLOB_S3_SECRET_KEY=rehydra-blobs
BLOB_S3_REGION=us-east-1
# matchd (compile + normalized compare). Unlisted images use MATCHD_URL.
MATCHD_URL=http://127.0.0.1:3001
# Required, no default. Must equal matchd's MATCHD_TOKEN. Use a real secret outside local dev.
MATCHD_TOKEN=dev-matchd-token
# Jobs claimed at once. Idle workers wait 2 seconds. Worker 0 runs a recipe recheck only when no submit is queued.
MATCHD_WORKERS=4
# One warm process per image. Extra warm copies are url|url. See docker-yml/docker-compose.matchd-pool.yml.
# MATCHD_ROUTES=ghcr.io/re-hydra/dc-gcc:sh4=http://127.0.0.1:3024,ghcr.io/re-hydra/ps2-gcc:mips64el=http://127.0.0.1:3016
# Start another local copy when an interactive job waits 30 seconds. off leaves the warm processes only.
MATCHD_SCALE=docker
MATCHD_SCALE_MAX=4
# Request body caps in MB (audit A-034). The import route takes a whole Ghidra export.
API_MAX_BODY_MB=4
API_MAX_IMPORT_MB=64
# Rate limits per client address and per sign-in email (audit A-035). off is for local test runs only.
RATE_LIMITS=on
# Comma-separated CIDRs of proxies whose X-Forwarded-For is trusted. Set this behind a load balancer,
# or every request looks like it comes from the balancer and shares one limit.
# TRUSTED_PROXIES=10.0.0.0/8
# Send Strict-Transport-Security (audit A-037). Turn on only when the API is served over HTTPS.
API_HSTS=off
# Outgoing email (password reset links, report alerts to admins). log writes to the API log; file writes JSON under MAIL_DIR.
# Both are local only. Production uses ses with a verified MAIL_FROM sender.
MAIL_DRIVER=log
# MAIL_DIR=.mail
# MAIL_FROM=re-hydra <no-reply@re-hydra.dev>
# SES_REGION=us-east-1
# SES_ACCESS_KEY=
# SES_SECRET_KEY=
# Public web origin, used to build links in emails.
APP_URL=http://localhost:5173
# How often site admins are emailed about new reports; a burst within one tick is one email.
# REPORT_NOTIFY_SECONDS=60
# Known-malware check (content policy 4.3). Without a URL the list is not downloaded.
# MalwareBazaar needs a free Auth-Key from https://auth.abuse.ch/; it is sent as an
# Auth-Key header and an auth-key parameter, or put where {AUTH_KEY} is in the URL.
# Copy the SHA-256 list URL from https://bazaar.abuse.ch/export/ (signed in). Plain
# text, ZIP, gzip and CSV lists all work; a file:// URL works for testing.
# MALWARE_HASHLIST_URL=
# MALWARE_HASHLIST_AUTH_KEY=
# MALWARE_HASHLIST_REFRESH_HOURS=24
# How often admins are emailed about new hits.
# MALWARE_NOTIFY_SECONDS=60
